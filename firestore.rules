rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny Catch-All)
    match /{document=**} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Global Hardened Primitives (Internal Shared Workspace)
    // ------------------------------------------------------------------
    function isInternalWorkspaceDoc(data) {
      return ('ownerId' in data) && data.ownerId == 'internal_wasdal';
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPejabatEntry(entry, requireInstansi) {
      return entry is map
        && entry.keys().hasAll(requireInstansi ? ['nama', 'nip', 'jabatan', 'instansi'] : ['nama', 'nip', 'jabatan'])
        && entry.keys().hasOnly(requireInstansi ? ['nama', 'nip', 'jabatan', 'instansi'] : ['nama', 'nip', 'jabatan'])
        && ('nama' in entry) && entry.nama is string && entry.nama.size() >= 1 && entry.nama.size() <= 150
        && ('nip' in entry) && entry.nip is string && entry.nip.size() <= 60
        && ('jabatan' in entry) && entry.jabatan is string && entry.jabatan.size() >= 1 && entry.jabatan.size() <= 200
        && (!requireInstansi || (('instansi' in entry) && entry.instansi is string && entry.instansi.size() >= 1 && entry.instansi.size() <= 200));
    }

    // ------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap & Low Call Depth)
    // ------------------------------------------------------------------
    function isValidWorkspaceConfig(data, workspaceId) {
      return data.keys().hasAll(['ownerId', 'seeded', 'kepalaDinas', 'kepalaBidang', 'ketuaTim', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'seeded', 'kepalaDinas', 'kepalaBidang', 'ketuaTim', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == workspaceId
        && data.ownerId == 'internal_wasdal'
        && data.seeded is bool
        && isValidPejabatEntry(data.kepalaDinas, true)
        && isValidPejabatEntry(data.kepalaBidang, false)
        && isValidPejabatEntry(data.ketuaTim, false)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPersonel(data) {
      return data.keys().hasAll(['ownerId', 'nama', 'jabatan', 'peran', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'nama', 'nip', 'jabatan', 'peran', 'email', 'isKetuaTim', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == 'internal_wasdal'
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 150
        && (!('nip' in data) || (data.nip is string && data.nip.size() <= 60))
        && data.jabatan is string && data.jabatan.size() >= 1 && data.jabatan.size() <= 200
        && (data.peran in ['ketua_tim', 'administrator', 'staf'])
        && (!('email' in data) || (data.email is string && data.email.size() <= 150))
        && (!('isKetuaTim' in data) || data.isKetuaTim is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSuratMasuk(data) {
      return data.keys().hasAll([
          'ownerId', 'nomorSurat', 'tanggalSurat', 'tanggalDiterima',
          'asalSurat', 'perihal', 'sifat',
          'penerimaDisposisiIds', 'penerimaDisposisiNama',
          'tahapSaatIni', 'statusSelesai', 'riwayatTindakLanjut',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'nomorAgenda', 'nomorSurat', 'tanggalSurat', 'tanggalDiterima',
          'asalSurat', 'perihal', 'sifat', 'tanggalDisposisi',
          'penerimaDisposisiIds', 'penerimaDisposisiNama',
          'instruksiDisposisi', 'catatanDisposisiKetuaTim', 'tenggatWaktu',
          'tahapSaatIni', 'statusSelesai', 'tanggalSelesai', 'riwayatTindakLanjut',
          'fileSuratMasuk', 'fileSuratKeluar', 'nomorSuratKeluar',
          'tanggalSuratKeluar', 'perihalSuratKeluar',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == 'internal_wasdal'
        && (!('nomorAgenda' in data) || (data.nomorAgenda is string && data.nomorAgenda.size() <= 100))
        && data.nomorSurat is string && data.nomorSurat.size() >= 1 && data.nomorSurat.size() <= 150
        && data.tanggalSurat is string && data.tanggalSurat.size() >= 4 && data.tanggalSurat.size() <= 40
        && data.tanggalDiterima is string && data.tanggalDiterima.size() >= 4 && data.tanggalDiterima.size() <= 40
        && data.asalSurat is string && data.asalSurat.size() >= 1 && data.asalSurat.size() <= 250
        && data.perihal is string && data.perihal.size() >= 1 && data.perihal.size() <= 1500
        && (data.sifat in ['Biasa', 'Penting', 'Segera', 'Sangat Segera', 'Rahasia'])
        && (!('tanggalDisposisi' in data) || (data.tanggalDisposisi is string && data.tanggalDisposisi.size() <= 40))
        && data.penerimaDisposisiIds is list
        && data.penerimaDisposisiIds.size() <= 30
        && (data.penerimaDisposisiIds.size() == 0 || (data.penerimaDisposisiIds[0] is string && data.penerimaDisposisiIds[0].size() <= 128))
        && data.penerimaDisposisiNama is list
        && data.penerimaDisposisiNama.size() <= 30
        && (data.penerimaDisposisiNama.size() == 0 || (data.penerimaDisposisiNama[0] is string && data.penerimaDisposisiNama[0].size() <= 150))
        && (!('instruksiDisposisi' in data) || (data.instruksiDisposisi is string && data.instruksiDisposisi.size() <= 1500))
        && (!('catatanDisposisiKetuaTim' in data) || (data.catatanDisposisiKetuaTim is string && data.catatanDisposisiKetuaTim.size() <= 1500))
        && (!('tenggatWaktu' in data) || (data.tenggatWaktu is string && data.tenggatWaktu.size() <= 40))
        && (data.tahapSaatIni is int && data.tahapSaatIni >= 1 && data.tahapSaatIni <= 7)
        && data.statusSelesai is bool
        && (!('tanggalSelesai' in data) || (data.tanggalSelesai is string && data.tanggalSelesai.size() <= 40))
        && data.riwayatTindakLanjut is list
        && data.riwayatTindakLanjut.size() <= 50
        && (data.riwayatTindakLanjut.size() == 0 || data.riwayatTindakLanjut[0] is map)
        && (!('fileSuratMasuk' in data) || (
          data.fileSuratMasuk is map
          && data.fileSuratMasuk.keys().hasAll(['nama', 'ukuran', 'tipe', 'tanggalUnggah', 'pengunggah'])
          && data.fileSuratMasuk.keys().hasOnly(['nama', 'ukuran', 'tipe', 'tanggalUnggah', 'pengunggah', 'dataUrl'])
          && data.fileSuratMasuk.nama is string && data.fileSuratMasuk.nama.size() >= 1 && data.fileSuratMasuk.nama.size() <= 255
          && data.fileSuratMasuk.ukuran is string && data.fileSuratMasuk.ukuran.size() >= 1 && data.fileSuratMasuk.ukuran.size() <= 40
          && data.fileSuratMasuk.tipe is string && data.fileSuratMasuk.tipe.size() >= 1 && data.fileSuratMasuk.tipe.size() <= 100
          && data.fileSuratMasuk.tanggalUnggah is string && data.fileSuratMasuk.tanggalUnggah.size() >= 1 && data.fileSuratMasuk.tanggalUnggah.size() <= 40
          && data.fileSuratMasuk.pengunggah is string && data.fileSuratMasuk.pengunggah.size() >= 1 && data.fileSuratMasuk.pengunggah.size() <= 150
          && (!('dataUrl' in data.fileSuratMasuk) || (data.fileSuratMasuk.dataUrl is string && data.fileSuratMasuk.dataUrl.size() <= 250000))
        ))
        && (!('fileSuratKeluar' in data) || (
          data.fileSuratKeluar is map
          && data.fileSuratKeluar.keys().hasAll(['nama', 'ukuran', 'tipe', 'tanggalUnggah', 'pengunggah'])
          && data.fileSuratKeluar.keys().hasOnly(['nama', 'ukuran', 'tipe', 'tanggalUnggah', 'pengunggah', 'dataUrl'])
          && data.fileSuratKeluar.nama is string && data.fileSuratKeluar.nama.size() >= 1 && data.fileSuratKeluar.nama.size() <= 255
          && data.fileSuratKeluar.ukuran is string && data.fileSuratKeluar.ukuran.size() >= 1 && data.fileSuratKeluar.ukuran.size() <= 40
          && data.fileSuratKeluar.tipe is string && data.fileSuratKeluar.tipe.size() >= 1 && data.fileSuratKeluar.tipe.size() <= 100
          && data.fileSuratKeluar.tanggalUnggah is string && data.fileSuratKeluar.tanggalUnggah.size() >= 1 && data.fileSuratKeluar.tanggalUnggah.size() <= 40
          && data.fileSuratKeluar.pengunggah is string && data.fileSuratKeluar.pengunggah.size() >= 1 && data.fileSuratKeluar.pengunggah.size() <= 150
          && (!('dataUrl' in data.fileSuratKeluar) || (data.fileSuratKeluar.dataUrl is string && data.fileSuratKeluar.dataUrl.size() <= 250000))
        ))
        && (!('nomorSuratKeluar' in data) || (data.nomorSuratKeluar is string && data.nomorSuratKeluar.size() <= 150))
        && (!('tanggalSuratKeluar' in data) || (data.tanggalSuratKeluar is string && data.tanggalSuratKeluar.size() <= 40))
        && (!('perihalSuratKeluar' in data) || (data.perihalSuratKeluar is string && data.perihalSuratKeluar.size() <= 1000))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidBerkasChunk(data) {
      return data.keys().hasAll(['ownerId', 'kind', 'chunkIndex', 'totalChunks', 'content', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'kind', 'chunkIndex', 'totalChunks', 'content', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == 'internal_wasdal'
        && (data.kind in ['masuk', 'keluar'])
        && (data.chunkIndex is int && data.chunkIndex >= 0 && data.chunkIndex <= 29)
        && (data.totalChunks is int && data.totalChunks >= 1 && data.totalChunks <= 30)
        && data.chunkIndex < data.totalChunks
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 700000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAkunKredensial(data, accountId) {
      return data.keys().hasAll(['ownerId', 'accountId', 'passwordHash', 'isDefaultReset', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'accountId', 'passwordHash', 'isDefaultReset', 'createdAt', 'updatedAt'])
        && isValidId(data.ownerId)
        && data.ownerId == 'internal_wasdal'
        && isValidId(data.accountId)
        && data.accountId == accountId
        && data.passwordHash is string && data.passwordHash.size() >= 16 && data.passwordHash.size() <= 200
        && data.isDefaultReset is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAgendaEvent(data) {
      return data.keys().hasAll([
          'ownerId', 'judul', 'kategori', 'tanggal', 'sepanjangHari',
          'jamMulai', 'jamSelesai', 'lokasi', 'pesertaIds', 'pesertaNama',
          'dibuatOlehId', 'dibuatOlehNama', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'judul', 'kategori', 'tanggal', 'sepanjangHari',
          'jamMulai', 'jamSelesai', 'lokasi', 'pesertaIds', 'pesertaNama',
          'pesertaTambahan', 'catatan', 'dibuatOlehId', 'dibuatOlehNama',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == 'internal_wasdal'
        && data.judul is string && data.judul.size() >= 1 && data.judul.size() <= 200
        && (data.kategori in ['Rapat Koordinasi', 'Tinjauan Lapangan', 'Asistensi', 'Audiensi', 'Lainnya'])
        && data.tanggal is string && data.tanggal.size() >= 4 && data.tanggal.size() <= 40
        && data.sepanjangHari is bool
        && data.jamMulai is string && data.jamMulai.size() >= 1 && data.jamMulai.size() <= 10
        && data.jamSelesai is string && data.jamSelesai.size() >= 1 && data.jamSelesai.size() <= 10
        && data.lokasi is string && data.lokasi.size() >= 1 && data.lokasi.size() <= 250
        && data.pesertaIds is list
        && data.pesertaIds.size() <= 30
        && (data.pesertaIds.size() == 0 || (data.pesertaIds[0] is string && data.pesertaIds[0].size() <= 128))
        && data.pesertaNama is list
        && data.pesertaNama.size() <= 30
        && (data.pesertaNama.size() == 0 || (data.pesertaNama[0] is string && data.pesertaNama[0].size() <= 150))
        && (!('pesertaTambahan' in data) || (data.pesertaTambahan is string && data.pesertaTambahan.size() <= 300))
        && (!('catatan' in data) || (data.catatan is string && data.catatan.size() <= 1500))
        && data.dibuatOlehId is string && data.dibuatOlehId.size() >= 1 && data.dibuatOlehId.size() <= 128
        && data.dibuatOlehNama is string && data.dibuatOlehNama.size() >= 1 && data.dibuatOlehNama.size() <= 150
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ------------------------------------------------------------------
    // Collection Rules (Internal Shared Workspace)
    // ------------------------------------------------------------------

    // 1. User Private Profile (Locked)
    match /users/{userId}/private/{docId} {
      allow read, write: if false;
    }

    // 2. Workspace Config (Pejabat Struktural & Seed State)
    match /workspaces/{workspaceId} {
      allow get: if isValidId(workspaceId) && workspaceId == 'internal_wasdal';
      allow list: if isInternalWorkspaceDoc(resource.data);
      allow create: if isValidId(workspaceId)
        && workspaceId == 'internal_wasdal'
        && isValidWorkspaceConfig(request.resource.data, workspaceId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(workspaceId)
        && workspaceId == 'internal_wasdal'
        && isInternalWorkspaceDoc(resource.data)
        && isValidWorkspaceConfig(request.resource.data, workspaceId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kepalaDinas', 'kepalaBidang', 'ketuaTim', 'updatedAt'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seeded', 'updatedAt'])
        );
      allow delete: if false;
    }

    // 3. Personel Tim
    match /personel/{personelId} {
      allow get: if isValidId(personelId) && isInternalWorkspaceDoc(resource.data);
      allow list: if isInternalWorkspaceDoc(resource.data);
      allow create: if isValidId(personelId)
        && isValidPersonel(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(personelId)
        && isInternalWorkspaceDoc(resource.data)
        && isValidPersonel(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'nip', 'jabatan', 'peran', 'email', 'isKetuaTim', 'updatedAt']);
      allow delete: if isValidId(personelId) && isInternalWorkspaceDoc(resource.data);
    }

    function isAllowedSuratMasukActiveUpdate(affected) {
      return affected.hasOnly([
          'penerimaDisposisiIds', 'penerimaDisposisiNama', 'instruksiDisposisi',
          'catatanDisposisiKetuaTim', 'tanggalDisposisi', 'tenggatWaktu',
          'tahapSaatIni', 'riwayatTindakLanjut', 'updatedAt'
        ])
        || affected.hasOnly([
          'tahapSaatIni', 'riwayatTindakLanjut', 'updatedAt'
        ])
        || affected.hasOnly([
          'statusSelesai', 'tanggalSelesai', 'riwayatTindakLanjut', 'updatedAt'
        ])
        || affected.hasOnly([
          'fileSuratKeluar', 'nomorSuratKeluar', 'tanggalSuratKeluar',
          'perihalSuratKeluar', 'statusSelesai', 'tanggalSelesai',
          'riwayatTindakLanjut', 'updatedAt'
        ])
        || affected.hasOnly([
          'nomorSurat', 'tanggalSurat', 'tanggalDiterima',
          'asalSurat', 'perihal', 'sifat', 'fileSuratMasuk',
          'riwayatTindakLanjut', 'updatedAt'
        ]);
    }

    // 4. Surat Masuk & Disposisi
    match /suratMasuk/{suratId} {
      allow get: if isValidId(suratId) && isInternalWorkspaceDoc(resource.data);
      allow list: if isInternalWorkspaceDoc(resource.data);
      allow create: if isValidId(suratId)
        && isValidSuratMasuk(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(suratId)
        && isInternalWorkspaceDoc(resource.data)
        && isValidSuratMasuk(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && (
          (
            // Terminal state lock: once statusSelesai == true, only explicit reopen allowed
            resource.data.statusSelesai == false
            && isAllowedSuratMasukActiveUpdate(request.resource.data.diff(resource.data).affectedKeys())
          )
          || (
            // Action 5: Reopen / Change Status Selesai from Terminal State
            resource.data.statusSelesai == true
            && request.resource.data.statusSelesai == false
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'statusSelesai', 'tanggalSelesai', 'riwayatTindakLanjut', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(suratId) && isInternalWorkspaceDoc(resource.data);

      // 4a. Multi-chunk PDF Attachment Subcollection
      match /berkasChunks/{chunkId} {
        allow get: if isValidId(suratId)
          && isValidId(chunkId)
          && isInternalWorkspaceDoc(resource.data)
          && exists(/databases/$(database)/documents/suratMasuk/$(suratId))
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.ownerId == 'internal_wasdal';
        allow list: if isInternalWorkspaceDoc(resource.data);
        allow create: if isValidId(suratId)
          && isValidId(chunkId)
          && isValidBerkasChunk(request.resource.data)
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && exists(/databases/$(database)/documents/suratMasuk/$(suratId))
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.ownerId == 'internal_wasdal'
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.statusSelesai == false;
        allow update: if isValidId(suratId)
          && isValidId(chunkId)
          && isInternalWorkspaceDoc(resource.data)
          && isValidBerkasChunk(request.resource.data)
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'kind', 'chunkIndex', 'totalChunks', 'content', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/suratMasuk/$(suratId))
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.ownerId == 'internal_wasdal'
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.statusSelesai == false;
        allow delete: if isValidId(suratId)
          && isValidId(chunkId)
          && isInternalWorkspaceDoc(resource.data)
          && exists(/databases/$(database)/documents/suratMasuk/$(suratId))
          && get(/databases/$(database)/documents/suratMasuk/$(suratId)).data.ownerId == 'internal_wasdal';
      }
    }

    // 5. Kredensial Akun Login (SHA-256 + Salt)
    match /akunKredensial/{accountId} {
      allow get: if isValidId(accountId) && (resource == null || isInternalWorkspaceDoc(resource.data));
      allow list: if isInternalWorkspaceDoc(resource.data);
      allow create: if isValidId(accountId)
        && isValidAkunKredensial(request.resource.data, accountId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(accountId)
        && isInternalWorkspaceDoc(resource.data)
        && isValidAkunKredensial(request.resource.data, accountId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.accountId == resource.data.accountId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'passwordHash', 'isDefaultReset', 'updatedAt'
        ]);
      allow delete: if isValidId(accountId) && isInternalWorkspaceDoc(resource.data);
    }

    // 6. Agenda Kegiatan Tim (Kalender)
    match /agenda/{agendaId} {
      allow get: if isValidId(agendaId) && isInternalWorkspaceDoc(resource.data);
      allow list: if isInternalWorkspaceDoc(resource.data);
      allow create: if isValidId(agendaId)
        && isValidAgendaEvent(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isValidId(agendaId)
        && isInternalWorkspaceDoc(resource.data)
        && isValidAgendaEvent(request.resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.dibuatOlehId == resource.data.dibuatOlehId
        && request.resource.data.dibuatOlehNama == resource.data.dibuatOlehNama
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'judul', 'kategori', 'tanggal', 'sepanjangHari',
          'jamMulai', 'jamSelesai', 'lokasi', 'pesertaIds', 'pesertaNama',
          'pesertaTambahan', 'catatan', 'updatedAt'
        ]);
      allow delete: if isValidId(agendaId) && isInternalWorkspaceDoc(resource.data);
    }
  }
}
