{
  "entities": {
    "WorkspaceConfig": {
      "title": "WorkspaceConfig",
      "description": "Konfigurasi pejabat penandatangan dan status inisialisasi workspace internal bersama",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID workspace internal bersama (internal_wasdal)"
        },
        "seeded": {
          "type": "boolean",
          "description": "Penanda apakah data awal sudah pernah disemai"
        },
        "kepalaDinas": {
          "type": "object",
          "description": "Data pejabat Kepala Dinas"
        },
        "kepalaBidang": {
          "type": "object",
          "description": "Data pejabat Kepala Bidang"
        },
        "ketuaTim": {
          "type": "object",
          "description": "Data pejabat Ketua Tim"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembuatan"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp pembaruan"
        }
      },
      "required": ["ownerId", "seeded", "kepalaDinas", "kepalaBidang", "ketuaTim", "createdAt", "updatedAt"]
    },
    "Personel": {
      "title": "Personel",
      "description": "Data personel tim pengawasan dan pengendalian perumahan",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "nip": {
          "type": "string",
          "maxLength": 60
        },
        "jabatan": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "peran": {
          "type": "string",
          "enum": ["ketua_tim", "administrator", "staf"]
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "isKetuaTim": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "nama", "jabatan", "peran", "createdAt", "updatedAt"]
    },
    "SuratMasuk": {
      "title": "SuratMasuk",
      "description": "Catatan surat masuk, disposisi Ketua Tim, progres tindak lanjut 7 tahap, dan lampiran surat",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "nomorAgenda": {
          "type": "string",
          "maxLength": 100
        },
        "nomorSurat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "tanggalSurat": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "tanggalDiterima": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "asalSurat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "perihal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "sifat": {
          "type": "string",
          "enum": ["Biasa", "Penting", "Segera", "Sangat Segera", "Rahasia"]
        },
        "tanggalDisposisi": {
          "type": "string",
          "maxLength": 40
        },
        "penerimaDisposisiIds": {
          "type": "array",
          "description": "Maksimal 30 ID personel penerima disposisi"
        },
        "penerimaDisposisiNama": {
          "type": "array",
          "description": "Maksimal 30 nama personel penerima disposisi"
        },
        "instruksiDisposisi": {
          "type": "string",
          "maxLength": 1500
        },
        "catatanDisposisiKetuaTim": {
          "type": "string",
          "maxLength": 1500
        },
        "tenggatWaktu": {
          "type": "string",
          "maxLength": 40
        },
        "tahapSaatIni": {
          "type": "integer",
          "enum": [1, 2, 3, 4, 5, 6, 7]
        },
        "statusSelesai": {
          "type": "boolean"
        },
        "tanggalSelesai": {
          "type": "string",
          "maxLength": 40
        },
        "riwayatTindakLanjut": {
          "type": "array",
          "description": "Riwayat tindak lanjut maksimal 50 entri"
        },
        "fileSuratMasuk": {
          "type": "object",
          "description": "Metadata berkas PDF surat masuk"
        },
        "fileSuratKeluar": {
          "type": "object",
          "description": "Metadata berkas PDF surat keluar"
        },
        "nomorSuratKeluar": {
          "type": "string",
          "maxLength": 150
        },
        "tanggalSuratKeluar": {
          "type": "string",
          "maxLength": 40
        },
        "perihalSuratKeluar": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "nomorSurat",
        "tanggalSurat",
        "tanggalDiterima",
        "asalSurat",
        "perihal",
        "sifat",
        "penerimaDisposisiIds",
        "penerimaDisposisiNama",
        "tahapSaatIni",
        "statusSelesai",
        "riwayatTindakLanjut",
        "createdAt",
        "updatedAt"
      ]
    },
    "BerkasChunk": {
      "title": "BerkasChunk",
      "description": "Potongan data dokumen PDF berukuran besar (> 250KB base64) yang disimpan permanen di Cloud Firestore",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["masuk", "keluar"]
        },
        "chunkIndex": {
          "type": "integer"
        },
        "totalChunks": {
          "type": "integer"
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "kind",
        "chunkIndex",
        "totalChunks",
        "content",
        "createdAt",
        "updatedAt"
      ]
    },
    "AkunKredensial": {
      "title": "AkunKredensial",
      "description": "Kredensial hash password akun pejabat dan personel untuk autentikasi aplikasi internal",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "passwordHash": {
          "type": "string",
          "minLength": 16,
          "maxLength": 200
        },
        "isDefaultReset": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "accountId",
        "passwordHash",
        "isDefaultReset",
        "createdAt",
        "updatedAt"
      ]
    },
    "AgendaEvent": {
      "title": "AgendaEvent",
      "description": "Jadwal agenda kegiatan tim pengawasan dan pengendalian perumahan di kalender",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "judul": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kategori": {
          "type": "string",
          "enum": ["Rapat Koordinasi", "Tinjauan Lapangan", "Asistensi", "Audiensi", "Lainnya"]
        },
        "tanggal": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "sepanjangHari": {
          "type": "boolean"
        },
        "jamMulai": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "jamSelesai": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "lokasi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 250
        },
        "pesertaIds": {
          "type": "array",
          "description": "Maksimal 30 ID personel peserta agenda"
        },
        "pesertaNama": {
          "type": "array",
          "description": "Maksimal 30 nama personel peserta agenda"
        },
        "pesertaTambahan": {
          "type": "string",
          "maxLength": 300
        },
        "catatan": {
          "type": "string",
          "maxLength": 1500
        },
        "status": {
          "type": "string",
          "enum": ["terjadwal", "dibatalkan", "dijadwalkan_ulang"],
          "description": "Status pelaksanaan agenda kegiatan"
        },
        "tanggalSebelumnya": {
          "type": "string",
          "maxLength": 40,
          "description": "Tanggal pelaksanaan sebelumnya sebelum dijadwalkan ulang"
        },
        "alasanStatus": {
          "type": "string",
          "maxLength": 500,
          "description": "Alasan pembatalan atau catatan penjadwalan ulang agenda"
        },
        "statusDiubahOleh": {
          "type": "string",
          "maxLength": 150
        },
        "statusDiubahPada": {
          "type": "string",
          "maxLength": 40
        },
        "dibuatOlehId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "dibuatOlehNama": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "judul",
        "kategori",
        "tanggal",
        "sepanjangHari",
        "jamMulai",
        "jamSelesai",
        "lokasi",
        "pesertaIds",
        "pesertaNama",
        "dibuatOlehId",
        "dibuatOlehNama",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceConfig" },
      "description": "Konfigurasi pejabat struktural dan status seeding workspace internal bersama"
    },
    "/personel/{personelId}": {
      "schema": { "$ref": "#/entities/Personel" },
      "description": "Daftar personel pengawasan dan pengendalian perumahan milik workspace internal"
    },
    "/suratMasuk/{suratId}": {
      "schema": { "$ref": "#/entities/SuratMasuk" },
      "description": "Daftar surat masuk, disposisi, dan tindak lanjut workspace internal"
    },
    "/suratMasuk/{suratId}/berkasChunks/{chunkId}": {
      "schema": { "$ref": "#/entities/BerkasChunk" },
      "description": "Potongan berkas PDF surat masuk dan surat keluar milik dokumen induk suratMasuk"
    },
    "/akunKredensial/{accountId}": {
      "schema": { "$ref": "#/entities/AkunKredensial" },
      "description": "Hash password SHA-256 tersalt milik akun pejabat dan personel"
    },
    "/agenda/{agendaId}": {
      "schema": { "$ref": "#/entities/AgendaEvent" },
      "description": "Jadwal agenda kegiatan tim (waktu, lokasi, dan personel peserta)"
    }
  }
}
